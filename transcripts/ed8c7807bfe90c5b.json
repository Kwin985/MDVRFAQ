{
  "source": "asr",
  "lang": "zh",
  "video_title": "2-ADAS中文校准",
  "segments": [
    {
      "start": 2.1,
      "end": 5.9,
      "text": "首先將ADES攝像頭固定在前擋風玻璃內側"
    },
    {
      "start": 5.9,
      "end": 8.5,
      "text": "刮水器上方水平線的中心上。"
    },
    {
      "start": 9.7,
      "end": 12.1,
      "text": "接下來測量車輛的寬度、"
    },
    {
      "start": 12.1,
      "end": 15.1,
      "text": "攝像機安裝位置到地面的高度、"
    },
    {
      "start": 15.1,
      "end": 18.5,
      "text": "攝像機安裝位置到前方車頭的距離、"
    },
    {
      "start": 18.5,
      "end": 21.5,
      "text": "攝像機安裝位置到車輛左側的距離、"
    },
    {
      "start": 21.5,
      "end": 24.9,
      "text": "攝像機安裝位置到前輪的中心點的距離"
    },
    {
      "start": 24.9,
      "end": 27.0,
      "text": "並記錄所有的測量值。"
    },
    {
      "start": 27.5,
      "end": 30.3,
      "text": "按遙控器ADES通道對應的數字鍵"
    },
    {
      "start": 30.3,
      "end": 31.9,
      "text": "放大視頻通道。"
    },
    {
      "start": 32.5,
      "end": 35.3,
      "text": "按遙控器的Enter鍵開始校準。"
    },
    {
      "start": 35.8,
      "end": 38.5,
      "text": "按遙控器的上、下、左、"
    },
    {
      "start": 38.5,
      "end": 42.0,
      "text": "有方向鍵調整屏幕中十字圖標的位置"
    },
    {
      "start": 42.0,
      "end": 45.9,
      "text": "將十字圖標與屏幕遠端的地平線中心對齊。"
    },
    {
      "start": 46.9,
      "end": 49.7,
      "text": "按遙控器上的Enter鍵輸入密碼"
    },
    {
      "start": 49.7,
      "end": 51.7,
      "text": "進入ADES標定界面。"
    },
    {
      "start": 52.3,
      "end": 55.5,
      "text": "在相應的選項中輸入之前記錄的數據"
    },
    {
      "start": 55.5,
      "end": 56.9,
      "text": "然後單機確定。"
    }
  ]
}