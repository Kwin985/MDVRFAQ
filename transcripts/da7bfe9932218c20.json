  "video_title": "3-DSM中文功能演示",
  "segments": [
    {
      "start": 2.1,
      "end": 7.1,
      "text": "同時按下遙控器的靜音鍵和Login鍵進入測試模式。"
    },
    {
      "start": 7.1,
      "end": 11.1,
      "text": "當駕駛員打哈欠時,設備會報警提示。"
    },
    {
      "start": 11.1,
      "end": 13.1,
      "text": "請勿疲勞駕駛。"
    },
    {
      "start": 13.1,
      "end": 18.1,
      "text": "當駕駛員長時間閉眼,設備會報警提示。"
    },
    {
      "start": 18.1,
      "end": 20.1,
      "text": "請勿疲勞駕駛。"
    },
    {
      "start": 20.1,
      "end": 25.1,
      "text": "當駕駛員左顧右判時,設備會報警提示。"
    },
    {
      "start": 25.1,
      "end": 27.1,
      "text": "請勿分神駕駛。"
    },
    {
      "start": 27.1,
      "end": 31.1,
      "text": "當駕駛員打電話時,設備會發出報警提示。"
    },
    {
      "start": 31.1,
      "end": 33.1,
      "text": "請勿使用手機。"
    },
    {
      "start": 33.1,
      "end": 38.1,
      "text": "當駕駛員遮擋攝像頭時,設備會進行報警提示。"
    },
    {
      "start": 38.1,
      "end": 40.1,
      "text": "請勿遮擋鏡頭。"
    },
    {
      "start": 40.1,
      "end": 44.1,
      "text": "當駕駛員吸煙時,設備會報警提示。"
    },
    {
      "start": 44.1,
      "end": 46.1,
      "text": "請勿吸煙。"
    },
    {
      "start": 46.1,
      "end": 51.1,
      "text": "當攝像頭無法識別駕駛員時,設備會報警提示。"
    },
    {
      "start": 51.1,
      "end": 54.1,
      "text": "識別失敗,請面對鏡頭。"
    }
  ]
