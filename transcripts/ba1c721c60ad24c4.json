{
  "source": "asr",
  "lang": "zh",
  "video_title": "2-BSD中文校准",
  "segments": [
    {
      "start": 1.8,
      "end": 6.3,
      "text": "将BSD镜头固定在车辆后侧方或前侧方。"
    },
    {
      "start": 6.3,
      "end": 12.3,
      "text": "调节螺丝松紧可以调试镜头方向。"
    },
    {
      "start": 13.3,
      "end": 17.8,
      "text": "按遥控器BSD通道对应的数字键放大视频通道。"
    },
    {
      "start": 17.8,
      "end": 22.3,
      "text": "按遥控器的Enter键,屏幕显示盲区分界线。"
    },
    {
      "start": 23.3,
      "end": 30.3,
      "text": "其中0、1、2、3、4不同颜色的线分别对应遥控器中的数字键0。"
    },
    {
      "start": 30.3,
      "end": 35.8,
      "text": "按遥控器的数字键0选中蓝线。"
    },
    {
      "start": 35.8,
      "end": 38.8,
      "text": "按遥控器的上下方向键调整位置。"
    },
    {
      "start": 38.8,
      "end": 42.8,
      "text": "按遥控器的数字键1选中黄色车身线。"
    },
    {
      "start": 42.8,
      "end": 45.8,
      "text": "按遥控器的左右方向键调整位置。"
    },
    {
      "start": 45.8,
      "end": 47.8,
      "text": "使黄线与车身对齐。"
    },
    {
      "start": 47.8,
      "end": 52.8,
      "text": "按遥控器的2、3、4键分别选中红黄绿线。"
    },
    {
      "start": 52.8,
      "end": 56.8,
      "text": "通过上下方向键可以选中颜色线的上下位置点。"
    },
    {
      "start": 56.8,
      "end": 58.8,
      "text": "按左右键调整位置。"
    },
    {
      "start": 59.8,
      "end": 62.3,
      "text": "按Enter键输入密码保存。"
    },
    {
      "start": 62.3,
      "end": 65.6,
      "text": "校准完成。"
    }
  ]
}