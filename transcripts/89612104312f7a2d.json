  "video_title": "1 The differences between the five MDVR models",
  "segments": [
    {
      "start": 1.2,
      "end": 5.2,
      "text": "The differences between the 5M DVR models."
    },
    {
      "start": 5.2,
      "end": 8.2,
      "text": "Sincerely serving you."
    },
    {
      "start": 8.2,
      "end": 13.2,
      "text": "Host appearance. We are divided into 5 types of consoles in total."
    },
    {
      "start": 13.2,
      "end": 17.2,
      "text": "They are the single card model M15HV."
    },
    {
      "start": 17.2,
      "end": 20.2,
      "text": "Dual card model M16HV."
    },
    {
      "start": 20.2,
      "end": 23.2,
      "text": "Equipped with camera model M20CV."
    },
    {
      "start": 23.2,
      "end": 28.2,
      "text": "Waterproof SSD hard drive model M32HV."
    },
    {
      "start": 28.2,
      "end": 34.2,
      "text": "And the intelligent hard drive model M5152HV."
    },
    {
      "start": 34.2,
      "end": 36.2,
      "text": "Storage medium."
    },
    {
      "start": 36.2,
      "end": 42.2,
      "text": "In terms of functionality, our 5 devices are gradually enhancing their functionality."
    },
    {
      "start": 42.2,
      "end": 48.2,
      "text": "M15HV1SD card can only store 512M of data."
    },
    {
      "start": 48.2,
      "end": 56.2,
      "text": "M16HV2SD card supports up to 2SD cards and can store up to 1TB of data."
    },
    {
      "start": 56.2,
      "end": 62.2,
      "text": "M20CV supports up to 2 microSD cards and can store up to 1TB of data."
    },
    {
      "start": 62.2,
      "end": 72.2,
      "text": "M32HV supports up to 1 SSD hard drive and 2 microSD cards with data storage capacity of over 2T."
    },
    {
      "start": 72.2,
      "end": 83.2,
      "text": "M5152HV supports up to 1 HDD hard drive and 2 microSD cards with data storage capacity of over 1.5T."
    },
    {
      "start": 83.2,
      "end": 93.2,
      "text": "The storage modes they support are shown in the figure."
    },
    {
      "start": 93.2,
      "end": 97.2,
      "text": "Numbers represent the quantity that can be used."
    },
    {
      "start": 97.2,
      "end": 99.2,
      "text": "Product features."
    },
    {
      "start": 99.2,
      "end": 101.2,
      "text": "M15HV."
    },
    {
      "start": 101.2,
      "end": 104.2,
      "text": "Equipped with 4G and GPS."
    },
    {
      "start": 104.2,
      "end": 106.2,
      "text": "Wi-Fi not supported."
    },
    {
      "start": 106.2,
      "end": 108.2,
      "text": "I not supported."
    },
    {
      "start": 108.2,
      "end": 110.2,
      "text": "Less expansion IO ports."
    },
    {
      "start": 110.2,
      "end": 112.2,
      "text": "M16HV."
    },
    {
      "start": 112.2,
      "end": 115.2,
      "text": "Equipped with 4G and GPS."
    },
    {
      "start": 115.2,
      "end": 117.2,
      "text": "Optional Wi-Fi."
    },
    {
      "start": 117.2,
      "end": 118.2,
      "text": "Optional I."
    },
    {
      "start": 118.2,
      "end": 121.2,
      "text": "Less expansion IO ports."
    },
    {
      "start": 121.2,
      "end": 123.2,
      "text": "Product features."
    },
    {
      "start": 123.2,
      "end": 125.2,
      "text": "M20CV."
    },
    {
      "start": 125.2,
      "end": 129.2,
      "text": "Supports 2-way video, expandable 2-way."
    },
    {
      "start": 129.2,
      "end": 133.2,
      "text": "Built-in GPS, 4G, and Wi-Fi."
    },
    {
      "start": 133.2,
      "end": 135.2,
      "text": "Support I."
    },
    {
      "start": 135.2,
      "end": 138.2,
      "text": "Comes with installation panel, 3M veneer."
    },
    {
      "start": 138.2,
      "end": 141.2,
      "text": "Less expansion IO ports."
    },
    {
      "start": 141.2,
      "end": 144.2,
      "text": "Product features."
    },
    {
      "start": 144.2,
      "end": 146.2,
      "text": "M32HV."
    },
    {
      "start": 146.2,
      "end": 148.2,
      "text": "Supports 4-way video."
    },
    {
      "start": 148.2,
      "end": 152.2,
      "text": "Equipped with 4G, 5G, and GPS."
    },
    {
      "start": 152.2,
      "end": 154.2,
      "text": "Optional Wi-Fi in I."
    },
    {
      "start": 154.2,
      "end": 156.2,
      "text": "More IO expansion ports."
    },
    {
      "start": 156.2,
      "end": 158.2,
      "text": "Can be waterproof."
    },
    {
      "start": 158.2,
      "end": 161.2,
      "text": "M5152HV."
    },
    {
      "start": 161.2,
      "end": 165.2,
      "text": "Supports 4-way video, M52HV 8-way."
    },
    {
      "start": 165.2,
      "end": 168.2,
      "text": "Equipped with 4G and GPS."
    },
    {
      "start": 168.2,
      "end": 170.2,
      "text": "Optional Wi-Fi."
    },
    {
      "start": 170.2,
      "end": 171.2,
      "text": "Optional I."
    },
    {
      "start": 171.2,
      "end": 175.2,
      "text": "Extremely strong IO scalability."
    }
  ]
}